# OPEN FEELING - local environment overrides.
# Copy to .env.local (Vite loads .env.local automatically) only if you need it.
#
# Firebase web configuration is committed in firebase-applet-config.json.
# The Firebase apiKey is a client identifier, not a secret - access control
# lives in firestore.rules - so no secret is required to run the app.

# Optional: Firebase App Check with reCAPTCHA v3.
# Create a site key in the Firebase console (App Check -> Web app), then set
# it here (and in your hosting provider's env) to attach attestation tokens
# to Firebase requests. See README "App Check" for the full steps, including
# enabling enforcement. Leave empty to disable App Check locally.
VITE_RECAPTCHA_SITE_KEY=

# Optional: show sample starter posts/communities when the database is empty.
# Intended for local development only - never enable in production.
VITE_ENABLE_SAMPLE_CONTENT=false

# Optional: allow the starter-community seed to run from a client session.
# Off by default everywhere; only enable deliberately in development.
VITE_ENABLE_STARTER_SEED=false
